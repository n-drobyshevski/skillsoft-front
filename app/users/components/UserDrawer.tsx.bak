"use client";

import React from "react";
import {
  Sheet,
  SheetContent,
  SheetHeader,
  SheetTitle,
} from "@/components/ui/sheet";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Separator } from "@/components/ui/separator";
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar";
import { Card, CardContent } from "@/components/ui/card";
import {
  User,
  UserRole,
  getUserInitials,
  getUserFullName,
  getRoleBadgeColor,
  getRoleDisplayName,
  getUserStatus,
  canUserAccess,
} from "@/app/interfaces/user-interfaces";
import {
  Mail,
  Calendar,
  Clock,
  Shield,
  ShieldCheck,
  ShieldAlert,
  User as UserIcon,
  Activity,
  Edit,
  UserX,
  UserCheck,
  Copy,
  ExternalLink,
  CheckCircle2,
  XCircle,
  Fingerprint,
  Ban,
  Lock,
  AlertTriangle,
  AtSign,
  Image,
} from "lucide-react";

interface UserDrawerProps {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  user: User;
}

export default function UserDrawer({
  open,
  onOpenChange,
  user,
}: UserDrawerProps) {
  const formatDate = (dateString?: string) => {
    if (!dateString) return "—";
    const date = new Date(dateString);
    return new Intl.DateTimeFormat("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    }).format(date);
  };

  const formatDateTime = (dateString?: string) => {
    if (!dateString) return "—";
    const date = new Date(dateString);
    return new Intl.DateTimeFormat("en-US", {
      weekday: "short",
      month: "short",
      day: "numeric",
      year: "numeric",
      hour: "numeric",
      minute: "2-digit",
    }).format(date);
  };

  const getTimeSince = (dateString?: string) => {
    if (!dateString) return null;
    const date = new Date(dateString);
    const now = new Date();
    const diffMs = now.getTime() - date.getTime();
    const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
    
    if (diffDays === 0) return "Today";
    if (diffDays === 1) return "Yesterday";
    if (diffDays < 7) return `${diffDays} days ago`;
    if (diffDays < 30) return `${Math.floor(diffDays / 7)} weeks ago`;
    if (diffDays < 365) return `${Math.floor(diffDays / 30)} months ago`;
    return `${Math.floor(diffDays / 365)} years ago`;
  };

  const getRoleIcon = (role: UserRole) => {
    switch (role) {
      case UserRole.ADMIN:
        return <ShieldAlert className="h-4 w-4" />;
      case UserRole.EDITOR:
        return <ShieldCheck className="h-4 w-4" />;
      case UserRole.USER:
        return <Shield className="h-4 w-4" />;
      default:
        return <Shield className="h-4 w-4" />;
    }
  };

  const getPermissions = (role: UserRole) => {
    switch (role) {
      case UserRole.ADMIN:
        return [
          { label: "Manage Users", allowed: true },
          { label: "Edit Content", allowed: true },
          { label: "View Reports", allowed: true },
          { label: "System Settings", allowed: true },
        ];
      case UserRole.EDITOR:
        return [
          { label: "Manage Users", allowed: false },
          { label: "Edit Content", allowed: true },
          { label: "View Reports", allowed: true },
          { label: "System Settings", allowed: false },
        ];
      case UserRole.USER:
        return [
          { label: "Manage Users", allowed: false },
          { label: "Edit Content", allowed: false },
          { label: "View Reports", allowed: false },
          { label: "Take Assessments", allowed: true },
        ];
      default:
        return [];
    }
  };

  const copyToClipboard = (text: string) => {
    navigator.clipboard.writeText(text);
    // Could add toast notification here
  };

  return (
    <Sheet open={open} onOpenChange={onOpenChange}>
      <SheetContent className="w-full sm:max-w-md overflow-y-auto p-0">
        {/* Header with gradient background */}
        <div className="relative bg-gradient-to-br from-primary/10 via-primary/5 to-transparent p-6 pb-8">
          {/* Warning banner for banned/locked users */}
          {(user.banned || user.locked) && (
            <div className={`mb-4 px-3 py-2 rounded-lg flex items-center gap-2 text-sm font-medium ${
              user.banned 
                ? 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400' 
                : 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400'
            }`}>
              {user.banned ? <Ban className="h-4 w-4" /> : <Lock className="h-4 w-4" />}
              {user.banned ? 'This user is banned' : 'This user is locked'}
            </div>
          )}
          <SheetHeader className="space-y-4">
            <div className="flex items-start gap-4">
              <div className="relative">
                <Avatar className="h-20 w-20 border-4 border-background shadow-xl ring-2 ring-primary/20">
                  {user.imageUrl && <AvatarImage src={user.imageUrl} alt={getUserFullName(user)} />}
                  <AvatarFallback className="bg-gradient-to-br from-primary/30 to-primary/10 text-primary text-2xl font-bold">
                    {getUserInitials(user)}
                  </AvatarFallback>
                </Avatar>
                {user.hasImage && (
                  <div className="absolute -bottom-1 -right-1 h-5 w-5 rounded-full bg-emerald-500 border-2 border-background flex items-center justify-center">
                    <Image className="h-3 w-3 text-white" />
                  </div>
                )}
              </div>
              <div className="flex-1 min-w-0 pt-1">
                <SheetTitle className="text-xl font-bold truncate">
                  {getUserFullName(user)}
                </SheetTitle>
                {user.username && (
                  <div className="flex items-center gap-1 mt-0.5 text-sm text-muted-foreground">
                    <AtSign className="h-3.5 w-3.5" />
                    <span>{user.username}</span>
                  </div>
                )}
                {user.email && (
                  <button 
                    onClick={() => copyToClipboard(user.email!)}
                    className="flex items-center gap-1.5 mt-1 text-sm text-muted-foreground hover:text-foreground transition-colors group"
                  >
                    <Mail className="h-3.5 w-3.5" />
                    <span className="truncate">{user.email}</span>
                    <Copy className="h-3 w-3 opacity-0 group-hover:opacity-100 transition-opacity" />
                  </button>
                )}
              </div>
            </div>

            {/* Status and Role badges */}
            <div className="flex items-center gap-2 flex-wrap">
              <Badge
                variant="outline"
                className={`gap-1.5 px-2.5 py-1 ${getRoleBadgeColor(user.role)}`}
              >
                {getRoleIcon(user.role)}
                {getRoleDisplayName(user.role)}
              </Badge>
              {(() => {
                const status = getUserStatus(user);
                const getStatusStyles = () => {
                  switch (status.variant) {
                    case 'success':
                      return "bg-emerald-100 text-emerald-700 hover:bg-emerald-100 dark:bg-emerald-900/30 dark:text-emerald-400";
                    case 'warning':
                      return "bg-amber-100 text-amber-700 hover:bg-amber-100 dark:bg-amber-900/30 dark:text-amber-400";
                    case 'destructive':
                      return "bg-red-100 text-red-700 hover:bg-red-100 dark:bg-red-900/30 dark:text-red-400";
                    default:
                      return "bg-gray-100 text-gray-600 hover:bg-gray-100 dark:bg-gray-800 dark:text-gray-400";
                  }
                };
                const getDotColor = () => {
                  switch (status.variant) {
                    case 'success': return 'bg-emerald-500';
                    case 'warning': return 'bg-amber-500';
                    case 'destructive': return 'bg-red-500';
                    default: return 'bg-gray-400';
                  }
                };
                return (
                  <Badge
                    variant="secondary"
                    className={`px-2.5 py-1 ${getStatusStyles()}`}
                  >
                    <span className={`mr-1.5 h-1.5 w-1.5 rounded-full ${getDotColor()}`} />
                    {status.label}
                  </Badge>
                );
              })()}
            </div>
          </SheetHeader>
        </div>

        <div className="px-6 pb-6 space-y-6">
          {/* Quick Stats */}
          <div className="grid grid-cols-2 gap-3 -mt-4">
            <Card className="bg-card/80 backdrop-blur-sm shadow-sm">
              <CardContent className="p-3">
                <div className="flex items-center gap-2 text-muted-foreground mb-1">
                  <Calendar className="h-3.5 w-3.5" />
                  <span className="text-xs">Clerk Account</span>
                </div>
                <div className="font-semibold text-sm">
                  {formatDate(user.clerkCreatedAt || user.createdAt)}
                </div>
              </CardContent>
            </Card>
            <Card className="bg-card/80 backdrop-blur-sm shadow-sm">
              <CardContent className="p-3">
                <div className="flex items-center gap-2 text-muted-foreground mb-1">
                  <Clock className="h-3.5 w-3.5" />
                  <span className="text-xs">Last sign in</span>
                </div>
                <div className="font-semibold text-sm">
                  {getTimeSince(user.lastSignInAt) || getTimeSince(user.lastLogin) || "Never"}
                </div>
              </CardContent>
            </Card>
          </div>

          {/* Permissions Section */}
          <div className="space-y-3">
            <div className="flex items-center gap-2 text-sm font-semibold">
              <Shield className="h-4 w-4 text-muted-foreground" />
              Permissions
            </div>
            <div className="grid grid-cols-2 gap-2">
              {getPermissions(user.role).map((perm) => (
                <div
                  key={perm.label}
                  className={`flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-medium ${
                    perm.allowed
                      ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-400"
                      : "bg-gray-50 text-gray-500 dark:bg-gray-800/50 dark:text-gray-500"
                  }`}
                >
                  {perm.allowed ? (
                    <CheckCircle2 className="h-3.5 w-3.5" />
                  ) : (
                    <XCircle className="h-3.5 w-3.5" />
                  )}
                  {perm.label}
                </div>
              ))}
            </div>
          </div>

          <Separator />

          {/* Account Details */}
          <div className="space-y-3">
            <div className="flex items-center gap-2 text-sm font-semibold">
              <Fingerprint className="h-4 w-4 text-muted-foreground" />
              Account Information
            </div>
            <div className="space-y-2">
              <InfoRow
                label="User ID"
                value={user.id}
                copyable
                onCopy={() => copyToClipboard(user.id)}
              />
              <InfoRow
                label="Clerk ID"
                value={user.clerkId}
                copyable
                onCopy={() => copyToClipboard(user.clerkId)}
              />
              {user.username && (
                <InfoRow label="Username" value={`@${user.username}`} />
              )}
              {user.firstName && (
                <InfoRow label="First Name" value={user.firstName} />
              )}
              {user.lastName && (
                <InfoRow label="Last Name" value={user.lastName} />
              )}
              {user.imageUrl && (
                <InfoRow label="Has Profile Image" value={user.hasImage ? "Yes" : "No"} />
              )}
            </div>
          </div>

          <Separator />

          {/* Activity Timeline */}
          <div className="space-y-3">
            <div className="flex items-center gap-2 text-sm font-semibold">
              <Activity className="h-4 w-4 text-muted-foreground" />
              Activity Timeline
            </div>
            <div className="space-y-3">
              {user.lastSignInAt && (
                <TimelineItem
                  icon={<Clock className="h-3.5 w-3.5" />}
                  title="Last Clerk sign-in"
                  date={formatDateTime(user.lastSignInAt)}
                  highlight
                />
              )}
              {user.lastLogin && !user.lastSignInAt && (
                <TimelineItem
                  icon={<Clock className="h-3.5 w-3.5" />}
                  title="Last login"
                  date={formatDateTime(user.lastLogin)}
                  highlight
                />
              )}
              {user.updatedAt && user.updatedAt !== user.createdAt && (
                <TimelineItem
                  icon={<Edit className="h-3.5 w-3.5" />}
                  title="Profile updated"
                  date={formatDateTime(user.updatedAt)}
                />
              )}
              {user.clerkCreatedAt && (
                <TimelineItem
                  icon={<UserIcon className="h-3.5 w-3.5" />}
                  title="Clerk account created"
                  date={formatDateTime(user.clerkCreatedAt)}
                />
              )}
              <TimelineItem
                icon={<UserIcon className="h-3.5 w-3.5" />}
                title="Synced to Skillsoft"
                date={formatDateTime(user.createdAt)}
              />
            </div>
          </div>

          {/* Actions */}
          <div className="pt-2 space-y-2">
            <Button className="w-full gap-2" variant="default">
              <Edit className="h-4 w-4" />
              Edit Profile
            </Button>
            <div className="grid grid-cols-2 gap-2">
              {user.isActive ? (
                <Button variant="outline" className="gap-2 text-orange-600 hover:text-orange-600 hover:bg-orange-50 dark:hover:bg-orange-950/20">
                  <UserX className="h-4 w-4" />
                  Deactivate
                </Button>
              ) : (
                <Button variant="outline" className="gap-2 text-emerald-600 hover:text-emerald-600 hover:bg-emerald-50 dark:hover:bg-emerald-950/20">
                  <UserCheck className="h-4 w-4" />
                  Activate
                </Button>
              )}
              <Button variant="outline" className="gap-2">
                <ExternalLink className="h-4 w-4" />
                View in Clerk
              </Button>
            </div>
          </div>
        </div>
      </SheetContent>
    </Sheet>
  );
}

// Helper component for info rows
function InfoRow({
  label,
  value,
  copyable = false,
  onCopy,
}: {
  label: string;
  value: string;
  copyable?: boolean;
  onCopy?: () => void;
}) {
  return (
    <div className="flex items-center justify-between gap-4 py-2 px-3 rounded-lg bg-muted/50 group">
      <span className="text-xs text-muted-foreground">{label}</span>
      <div className="flex items-center gap-2">
        <span className="text-xs font-mono text-foreground truncate max-w-[160px]" title={value}>
          {value}
        </span>
        {copyable && onCopy && (
          <button
            onClick={onCopy}
            className="p-1 hover:bg-muted rounded opacity-0 group-hover:opacity-100 transition-opacity"
          >
            <Copy className="h-3 w-3 text-muted-foreground" />
          </button>
        )}
      </div>
    </div>
  );
}

// Helper component for timeline items
function TimelineItem({
  icon,
  title,
  date,
  highlight = false,
}: {
  icon: React.ReactNode;
  title: string;
  date: string;
  highlight?: boolean;
}) {
  return (
    <div className="flex items-start gap-3">
      <div className={`p-1.5 rounded-full ${highlight ? "bg-primary/10 text-primary" : "bg-muted text-muted-foreground"}`}>
        {icon}
      </div>
      <div className="flex-1 min-w-0">
        <p className={`text-sm ${highlight ? "font-medium" : ""}`}>{title}</p>
        <p className="text-xs text-muted-foreground">{date}</p>
      </div>
    </div>
  );
}
